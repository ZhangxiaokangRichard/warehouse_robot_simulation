<?xml version="1.0" encoding="UTF-8"?>

<launch>

  <!-- World File -->
  <arg name="world_file" default="$(find warehouse_robot_simulation)/worlds/warehouse.world"/>

  <!-- Launch Gazebo World -->
  <include file="$(find gazebo_ros)/launch/empty_world.launch">
    <arg name="use_sim_time" value="true"/>
    <arg name="debug" value="false"/>
    <arg name="gui" value="true" />
    <arg name="world_name" value="$(arg world_file)"/>
  </include>

  <!-- Move Barrier Node - Controls dynamic obstacles -->
  <!-- Launch with delay to ensure Gazebo is ready -->
  <node name="move_barrier" pkg="warehouse_robot_simulation" type="move_barrier.py" output="screen" launch-prefix="bash -c 'sleep 3; exec &quot;$@&quot;' _" respawn="true" respawn_delay="2">
    <!-- Barrier update rate (Hz) -->
    <param name="update_rate" value="20"/>

    <!-- Barrier names as string -->
    <param name="barrier_names" value="barrier_1,barrier_2,barrier_3" type="str"/>

    <!-- Barrier 1: Patrols the main open aisle (between dispatch and storage) -->
    <param name="barriers/barrier_1/diameter" value="0.1"/>
    <param name="barriers/barrier_1/height" value="0.8"/>
    <param name="barriers/barrier_1/speed" value="0.3"/>
    <param name="barriers/barrier_1/start_position/x" value="-2.0"/>
    <param name="barriers/barrier_1/start_position/y" value="2.0"/>
    <rosparam param="barriers/barrier_1/path">
      - [-4.0,  1.0]
      - [-2.0,  1.0]
      - [-2.0,  -1.0]
      - [-4.0,  -1.0]
    </rosparam>

    <!-- Barrier 2: Patrols along the storage corridor -->
    <param name="barriers/barrier_2/diameter" value="0.1"/>
    <param name="barriers/barrier_2/height" value="0.8"/>
    <param name="barriers/barrier_2/speed" value="0.25"/>
    <param name="barriers/barrier_2/start_position/x" value="4.0"/>
    <param name="barriers/barrier_2/start_position/y" value="-1.0"/>
    <rosparam param="barriers/barrier_2/path">
      - [ 4.0, -1.0]
      - [ 1.5, -1.0]
      - [ 1.5, 1.0]
      - [ 4.0, 1.0]
    </rosparam>

    <!-- Barrier 3: Patrols the left aisle -->
    <param name="barriers/barrier_3/diameter" value="0.1"/>
    <param name="barriers/barrier_3/height" value="0.8"/>
    <param name="barriers/barrier_3/speed" value="0.35"/>
    <param name="barriers/barrier_3/start_position/x" value="-1.0"/>
    <param name="barriers/barrier_3/start_position/y" value="-2.0"/>
    <rosparam param="barriers/barrier_3/path">
      - [ 0.0, -2.0]
      - [-1.0, -2.0]
      - [-1.0, -3.0]
      - [ 0.0, -3.0]
    </rosparam>
  </node>

</launch>
